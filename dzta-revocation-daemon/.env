# ==============================================================================
# dZTA Layer 4 Edge & Revocation Daemon Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hyperledger Fabric Network Bindings
# ------------------------------------------------------------------------------
CONFIG_PATH=config/connection-profile.yaml
FABRIC_CHANNEL=dzta
FABRIC_CHAINCODE=dztac
FABRIC_ORG=Org1MSP
FABRIC_PEER=org1-peer1

# gRPC Endpoint for the Fabric Peer
FABRIC_PEER_ENDPOINT=grpcs://org1-peer1.test-network.svc.cluster.local:7051

# ------------------------------------------------------------------------------
# 2. Envoy Admin & Edge Proxy Bindings
# ------------------------------------------------------------------------------
# Public Ingress port for downstream edge client traffic (dZTA ZKP Enforcer)
EDGE_INGRESS_PORT=10000

# Wasm Admin Port (Loopback interface for Revocation Ingestion)
WASM_ADMIN_PORT=9099

# Envoy Core Admin Port (Stats / Clusters / Health checks)
ENVOY_ADMIN_PORT=9901

# URL for the Fabric Daemon to push real-time revocation updates into Wasm SharedData
# Points to port 9099 (Wasm Admin) rather than 9901 (Envoy Core Admin)
ENVOY_ADMIN_URL=http://127.0.0.1:9099

# Shared Secret Token for X-Wasm-Admin-Token validation
ADMIN_TOKEN=dzta_internal_revocation_secret_key

# ------------------------------------------------------------------------------
# 3. Application Logging & Environment
# ------------------------------------------------------------------------------
RUST_LOG=info
ENVIRONMENT=production