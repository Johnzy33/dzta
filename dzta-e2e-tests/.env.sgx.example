# Copy to .env.sgx and load it with: set -a; source dzta-e2e-tests/.env.sgx; set +a
# Do not commit .env.sgx. It contains wallet/KMS/Vault secrets.

# Fabric connection profile on the SGX client.
DZTA_FABRIC_CONFIG=/absolute/path/to/dzta/dzta-e2e-tests/config/connection-profile.yaml
DZTA_WALLET_PASSPHRASE=replace-with-test-wallet-passphrase
DZTA_TEST_SUBJECT_DID=did:dzta:user-sgx-e2e

# Intel DCAP collateral service.
PCCS_URL=https://your-pccs.example

# Exact measurements for the signed dzta-gramine-prover image.
DZTA_MRENCLAVE=replace-with-64-hex-character-value
DZTA_MRSIGNER=replace-with-64-hex-character-value

# Select exactly one secret provider: https or vault.
DZTA_SECRET_PROVIDER=https

# Custom HTTPS KMS mode.
DZTA_KMS_ENDPOINT=https://kms.example/v1/enclave/release
DZTA_KMS_BEARER_TOKEN=replace-with-kms-token

# Vault Transit mode alternative.
# DZTA_SECRET_PROVIDER=vault
# VAULT_ADDR=https://vault.example
# VAULT_TOKEN=replace-with-vault-token
# DZTA_VAULT_TRANSIT_KEY=dzta-secrets
# DZTA_VAULT_WALLET_CIPHERTEXT=vault:v1:replace-with-ciphertext
# DZTA_VAULT_SEED_CIPHERTEXT=vault:v1:replace-with-ciphertext
